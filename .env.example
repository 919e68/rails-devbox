# Copy to .env and fill in: cp .env.example .env
# Docker Compose reads .env from this folder on its own (also when VS Code starts the box).
# .env is gitignored and never sent to the Docker build. Keep it private: it can hold a login token.

# Your user and group IDs on this machine. The container user gets the same IDs,
# so files it writes into home/ are owned by you. Find yours with: id -u / id -g
# Default is 1000. After changing either, rebuild: docker compose up -d --build
UID=1000
GID=1000

# Name shown as a badge at the start of the shell prompt and in the Claude Code status line,
# so you can tell boxes apart. Default: rails-devbox
BOX_NAME=rails-devbox
# Badge background: a color name (black, red, green, yellow, blue, purple, cyan, white,
# or bright-red and so on) or a hex color such as #d7005f. Default: blue
BOX_COLOR=blue
# After changing either: docker compose up -d, then open a new shell or restart claude

# Postgres and Redis image versions for this box. Defaults: 18 and 8
# Use a Postgres major version only (16, 17, 18). Each major keeps its data in its own folder
# of the postgres-data volume, so switching versions starts with an empty server; switching back
# finds the old data again. Move data across with pg_dump / pg_restore.
# The pg_dump / psql client in the box is 18: it works with 18 and older servers.
# After changing either: docker compose up -d
POSTGRES_VERSION=18
REDIS_VERSION=8

# Optional. Logs Claude Code in on start, so you skip the interactive `claude` login.
# Create one with `claude setup-token` (on this machine or inside the box), then uncomment. See README, First-time setup.
# Leave it commented out rather than empty: an empty value is still passed to the container.
# After changing it, recreate the container (no rebuild needed): docker compose up -d
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...

# Optional. GitHub token for the gh CLI and for git over HTTPS (clone/pull/push with https:// URLs).
# SSH remotes (git@github.com:...) still need the SSH key from the README.
# Use a classic personal access token from https://github.com/settings/tokens/new
# (classic scopes: repo, read:org, workflow), or copy an existing gh login with `gh auth token`.
# Leave it commented out rather than empty. After changing it: docker compose up -d
# GH_TOKEN=ghp_...

# Optional. Jira and Confluence REST API access. The values are in the container environment,
# so scripts and Claude Code can call https://$ATLASSIAN_SITE/rest/api/3/... with Basic auth,
# and acli is logged in on start. Create the token at https://id.atlassian.com/manage-profile/security/api-tokens
# (see README, First-time setup). Leave them commented out rather than empty. After changing them: docker compose up -d
# ATLASSIAN_SITE=yourcompany.atlassian.net
# ATLASSIAN_EMAIL=you@example.com
# ATLASSIAN_API_TOKEN=ATATT...
